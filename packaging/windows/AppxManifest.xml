<?xml version="1.0" encoding="utf-8"?>
<!-- MSIX manifest for the Microsoft Store. build_msix.py fills in @VERSION@.
     Name, Publisher and PublisherDisplayName must match Partner Center →
     Product management → Product identity exactly. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="LeonardoNels.fillmate"
    Publisher="CN=C168353D-6421-47B7-A613-B7298F87728B"
    Version="@VERSION@"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>fillmate</DisplayName>
    <PublisherDisplayName>Leonardo Nels</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="fillmate" Executable="@EXECUTABLE@" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="fillmate"
        Description="Fill recurring paperwork from reusable form packs and send it by email."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
